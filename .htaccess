# Proteções para a cópia completa do repositório no public_html da HostGator.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(?:\.git|\.github|ferramentas)(?:/|$) - [F,NC,L]
</IfModule>

<FilesMatch "\.(?:md|cjs|ps1|ya?ml)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
